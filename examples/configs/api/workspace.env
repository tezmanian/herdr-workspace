# Main project (an API in DDEV). Copy this folder to <repo>/.agents/workspace/ and adapt.
WS_BASE_BRANCH=master
WS_SUBS="web"                       # the frontend, a folder next to this repo

# Untracked files a checkout needs, and big dirs cloned instead of reinstalled.
WS_COPY=".claude .agents CLAUDE.md CLAUDE.local.md .env.local"
WS_COPY_PATTERNS="STATUS.md ai-docs/***"
WS_CLONE="vendor"

WS_SETUP='"$WS_CONFIG_DIR/setup.sh"'
WS_TEARDOWN="ddev delete -Oy"       # free the containers when the workspace is removed

# Untracked files offered for copy-back to the main checkout on removal.
WS_KEEP="STATUS.md"
WS_IGNORED_ON_REMOVE=ask

# Orchestration: plan with a strong model, implement with a cheaper one, review with another agent.
WS_PLAN=worker
WS_PLAN_MODEL="claude-opus-5-5"
WS_IMPLEMENT_MODEL="claude-sonnet-5-5"
WS_REVIEW=on
WS_REVIEW_AGENT=codex
WS_REVIEW_ROUNDS=2
WS_AUTONOMY=off
WS_ESCALATE="database migrations, anything touching billing"
