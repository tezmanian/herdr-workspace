# Sub repo (a Next.js frontend). Copy this folder to <repo>/.agents/workspace/ and adapt.
WS_BASE_BRANCH=main

WS_COPY=".claude .agents CLAUDE.md .env.example"
WS_CLONE="node_modules"                                   # copy-on-write where the filesystem allows

WS_SETUP='"$WS_CONFIG_DIR/setup.sh"'
WS_TEARDOWN=""                                            # nothing to stop; the dev server dies with its terminal

WS_IMPLEMENT_MODEL="claude-sonnet-5-5"
WS_IMPLEMENT_BRIEF="Components live in src/components, use the existing design tokens. Run 'npm run lint' and 'npm test' before you report."
