# herdr-workspace config template. Copy this folder to <repo>/.agents/workspace/ (or .herdr/workspace/, or
# ~/.config/herdr-workspace/projects/<repo dir name>/) and fill in what the repo needs. Sourced by bash.

# Base for new branches.
WS_BASE_BRANCH=master
# Main project only: sub repos added by default (path, or folder name next to the main project).
WS_SUBS=""

# Untracked files a checkout needs (gitignored config, agent rules, docs). Copied without overwriting.
WS_COPY=".claude .agents CLAUDE.md CLAUDE.local.md AGENTS.md"
# rsync include patterns copied from anywhere in the tree, e.g. "STATUS.md ai-docs/***".
WS_COPY_PATTERNS=""
WS_COPY_EXCLUDE=""
# Big dependency dirs, cloned with copy-on-write where the filesystem allows it: vendor, node_modules, .venv …
WS_CLONE=""

# Commands run in the worktree after copying. Env: WS_MAIN (main checkout), WS_CONFIG_DIR (this folder), the
# parent's exports (e.g. API_URL, WS_SLOT). Append KEY=value lines to "$WS_EXPORT" to export for sub workspaces.
WS_SETUP='"$WS_CONFIG_DIR/setup.sh"'
WS_POST_SETUP=""
# Command run in the worktree before removal (stop containers or VMs, free slots), e.g.
# "ddev delete -Oy", "vagrant destroy -f", "docker compose down".
WS_TEARDOWN=""

# On removal: untracked paths/patterns that may go back to the main checkout; ask | copy | delete.
WS_KEEP=""
WS_IGNORED_ON_REMOVE=ask

# Agents and models per role: Herdr agent kind (claude, codex, …), provider model id (empty = the agent's default),
# effort (needs a model; claude and codex only), extra native agent arguments (*_ARGS, e.g. "--permission-mode acceptEdits").
# Orchestrator and planner: main project only; implementer: per repo.
WS_ORCHESTRATOR_AGENT=claude
WS_ORCHESTRATOR_MODEL=""
WS_ORCHESTRATOR_EFFORT=""
WS_ORCHESTRATOR_ARGS=""
WS_PLAN_AGENT=claude
WS_PLAN_MODEL=""
WS_PLAN_EFFORT=""
WS_PLAN_ARGS=""
WS_IMPLEMENT_AGENT=claude
WS_IMPLEMENT_MODEL=""
WS_IMPLEMENT_EFFORT=""
WS_IMPLEMENT_ARGS=""
WS_REVIEW_AGENT=claude
WS_REVIEW_MODEL=""
WS_REVIEW_EFFORT=""
WS_REVIEW_ARGS=""

# Orchestrator (main project): worker | self | none; review stops; skills; briefs (<spec> = spec path).
WS_PLAN=worker
WS_PLAN_BREAKS=""
WS_PLAN_SKILL=""
WS_IMPLEMENT_SKILL=""
WS_PLAN_BRIEF=""
WS_IMPLEMENT_BRIEF=""

# Code review after each implementer (main project): on | off; skills, brief, max fix rounds.
WS_REVIEW=off
WS_REVIEW_SKILL=""
WS_REVIEW_BRIEF=""
WS_REVIEW_ROUNDS=2

# Autonomous mode (main project): a Decider agent answers questions and approves the plan instead of the user.
WS_AUTONOMY=off
WS_DECIDE_SKILL=""
WS_DECIDE_BRIEF=""
WS_ESCALATE=""
WS_DECIDE_AGENT=claude
WS_DECIDE_MODEL=""
WS_DECIDE_EFFORT=""
WS_DECIDE_ARGS=""

# Context hygiene: commands sent to idle workers (empty = none). Implementer timing: workstream | task.
WS_PLANNER_AFTER="/compact"
WS_IMPLEMENTER_AFTER="/clear"
WS_IMPLEMENTER_AFTER_WHEN=workstream
WS_DECIDER_AFTER=""
